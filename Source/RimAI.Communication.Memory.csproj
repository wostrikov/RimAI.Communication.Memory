<Project Sdk="Microsoft.NET.Sdk">
  <!--
    RimWorld 1.7 and nothing older. 1.7 is not a Unity player: it runs on
    .NET 10, its assemblies sit in the game folder itself, and one assembly -
    UnityStubs - stands in for everything that was UnityEngine.*Module.dll.
    So this is net10.0 and compiles against that stand-in, which turns a
    Unity member 1.7 does not have into a compile error here instead of a
    type that fails to load there. The 1.6 build is the tag
    rimworld-1.6-final.
  -->

	<PropertyGroup>
		<!-- 配置变量 -->
		<GameVersion Condition=" '$(GameVersion)' == '' ">1.7</GameVersion>
		<DefineConstants>$(DefineConstants);V$(GameVersion.Replace('.', '_'))</DefineConstants>

		<RimWorldDir Condition=" '$(RimWorldDir)' == '' ">$(RIMWORLD_DIR)</RimWorldDir>
		<RimWorldWorkshopDir Condition=" '$(RimWorldWorkshopDir)' == '' ">$(RIMWORLD_WORKSHOP_DIR)</RimWorldWorkshopDir>
		<BaseOutputPath Condition=" '$(BaseOutputPath)' == '' ">$(LOCALAPPDATA)\Ustas\RimWorldSourceBuilds\RimAI.Communication.Memory\bin\</BaseOutputPath>
		<BaseIntermediateOutputPath Condition=" '$(BaseIntermediateOutputPath)' == '' ">$(LOCALAPPDATA)\Ustas\RimWorldSourceBuilds\RimAI.Communication.Memory\obj\</BaseIntermediateOutputPath>

		<ModFolderName>RimAI.Communication.Memory</ModFolderName>
		<ModRoot>$(MSBuildProjectDirectory)\..</ModRoot>

		<!-- 编程配置项 -->
		<RootNamespace>Ustas.RimAI.Communication.Memory</RootNamespace>
		<LangVersion>latest</LangVersion>

		<!-- 编译配置项 -->
		<OutputType>Library</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<!-- The game loads a mod assembly from the mod's own folder: no deps
		     file beside it. A package this mod ships has to reach the output. -->
		<GenerateDependencyFile>false</GenerateDependencyFile>
		<GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<Platforms>AnyCPU;x64</Platforms>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<AssemblyName>RimAI.Communication.Memory</AssemblyName>

		<!-- 编译项优化 -->
		<UseSharedCompilation>false</UseSharedCompilation>
		<UseHostCompilerIfAvailable>false</UseHostCompilerIfAvailable>
		<Deterministic>true</Deterministic>
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>

		<!-- 输出文件夹 -->
		<OutputPath>$(BaseOutputPath)$(Configuration)\</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

		<!-- 杂项配置，VS开发的时候没用到过，应该是用于VScode的 -->
		<ProvideCommandLineArgs>false</ProvideCommandLineArgs>
		<LongPathsEnabled>true</LongPathsEnabled>
		<DisableImplicitFrameworkReferences>false</DisableImplicitFrameworkReferences>
	</PropertyGroup>

	<ItemGroup>
		<!-- NuGet包引用 -->
		<PackageReference Include="Krafs.Rimworld.Ref" Version="$(GameVersion).*-*" PrivateAssets="All" />
		<PackageReference Include="Lib.Harmony" Version="3.0.0-rc.2" ExcludeAssets="runtime" PrivateAssets="All" />
		<!-- The installed SDK compiler supports the language features used here; avoid a .NET 9-only build tool dependency. -->
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />

		<!-- 程序集引用 -->
		<ProjectReference Include="..\..\RimAI.Communication\Source\RimAI.Communication.csproj">
			<Private>False</Private>
		</ProjectReference>
		<ProjectReference Include="..\..\RimAI.Core\src\RimAI.Core\RimAI.Core.csproj">
			<Private>False</Private>
		</ProjectReference>

		<!-- 排除文件 -->
		<Compile Remove="..\RimTalk\**" />
		<Compile Remove="backup\**" />
		<Compile Remove="Backups\**" />
		<Compile Remove="**\*.backup.cs" />
	</ItemGroup>

	<!-- 编译后自动部署 -->
	<Target Name="DeployToModsFolder" AfterTargets="Build" Condition=" '$(BuildingWithScript)' != 'true' AND '$(RimWorldDir)' != '' ">
		<CallTarget Targets="WinDeploy" Condition=" '$(OS)' == 'Windows_NT' " />
		<CallTarget Targets="MacDeploy" Condition=" '$(OS)' != 'Windows_NT' " />
	</Target>

	<!--
	  Stage assemblies into the versioned mod layout before content sync.
	  /*/Assemblies is gitignored and BaseOutputPath lives under LOCALAPPDATA, so a plain
	  robocopy/rsync of $(GameVersion) would publish Defs without the built DLL — which is
	  exactly how MainTabWindow_Memory became an unresolved XML type at runtime.
	-->
	<Target Name="StageModAssemblies">
		<MakeDir Directories="$(ModRoot)\$(GameVersion)\Assemblies" />
		<ItemGroup>
			<_StagedAssemblies Include="$(TargetPath)" />
			<_StagedAssemblies Include="$(OutputPath)Newtonsoft.Json.dll" Condition="Exists('$(OutputPath)Newtonsoft.Json.dll')" />
		</ItemGroup>
		<Copy SourceFiles="@(_StagedAssemblies)" DestinationFolder="$(ModRoot)\$(GameVersion)\Assemblies\" SkipUnchangedFiles="true" />
	</Target>

	<!-- Deploy to RimWorld client (Windows) -->
	<Target Name="WinDeploy" DependsOnTargets="StageModAssemblies">
		<PropertyGroup>
			<WinModPath>$(RimWorldDir)\Mods\$(ModFolderName)\</WinModPath>
		</PropertyGroup>
		<Message Text="Copying to $(WinModPath)" Importance="high" />
		<MakeDir Directories="$(WinModPath)" />
		<Exec Command="robocopy &quot;$(ModRoot)\About&quot; &quot;$(WinModPath)About&quot; /MIR" IgnoreExitCode="true" />
		<Exec Command="robocopy &quot;$(ModRoot)\Languages&quot; &quot;$(WinModPath)Languages&quot; /MIR" IgnoreExitCode="true" />
		<Exec Command="robocopy &quot;$(ModRoot)\Textures&quot; &quot;$(WinModPath)Textures&quot; /MIR" IgnoreExitCode="true" />
		<Exec Command="robocopy &quot;$(ModRoot)\$(GameVersion)&quot; &quot;$(WinModPath)$(GameVersion)&quot; /MIR" IgnoreExitCode="true" />
		<Message Text="--- Windows deployment finished successfully ---" Importance="high" />
	</Target>

	<!-- Deploy to RimWorld client (macOS) -->
	<Target Name="MacDeploy" DependsOnTargets="StageModAssemblies">
		<PropertyGroup>
			<DeployPath>$(RimWorldDir)/RimWorldMac.app/Mods/$(ModFolderName)/</DeployPath>
		</PropertyGroup>
		<MakeDir Directories="$(DeployPath)" />
		<Exec Command="rsync -a --delete --checksum &quot;$(ModRoot)\About/&quot; &quot;$(DeployPath)About/&quot;" />
		<Exec Command="rsync -a --delete --checksum &quot;$(ModRoot)\Languages/&quot; &quot;$(DeployPath)Languages/&quot;" />
		<Exec Command="rsync -a --delete --checksum &quot;$(ModRoot)\Textures/&quot; &quot;$(DeployPath)Textures/&quot;" />
		<Exec Command="rsync -a --delete --checksum &quot;$(ModRoot)\$(GameVersion)/&quot; &quot;$(DeployPath)$(GameVersion)/&quot;" />
		<Message Text="--- macOS deployment finished successfully ---" Importance="high" />
	</Target>

</Project>

