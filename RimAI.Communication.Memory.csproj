<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- 配置变量 -->
		<GameVersion Condition=" '$(GameVersion)' == '' ">1.6</GameVersion>
		<DefineConstants>$(DefineConstants);V$(GameVersion.Replace('.', '_'))</DefineConstants>

		<RimWorldDir Condition=" '$(RimWorldDir)' == '' ">$(RIMWORLD_DIR)</RimWorldDir>
		<RimWorldWorkshopDir Condition=" '$(RimWorldWorkshopDir)' == '' ">$(RIMWORLD_WORKSHOP_DIR)</RimWorldWorkshopDir>
		<BaseOutputPath Condition=" '$(BaseOutputPath)' == '' ">$(LOCALAPPDATA)\Ustas\RimWorldSourceBuilds\RimAI.Communication.Memory\bin\</BaseOutputPath>
		<BaseIntermediateOutputPath Condition=" '$(BaseIntermediateOutputPath)' == '' ">$(LOCALAPPDATA)\Ustas\RimWorldSourceBuilds\RimAI.Communication.Memory\obj\</BaseIntermediateOutputPath>

		<ModFolderName>RimAI.Communication.Memory</ModFolderName>

		<!-- 编程配置项 -->
		<RootNamespace>Ustas.RimAI.Communication.Memory</RootNamespace>
		<LangVersion>latest</LangVersion>

		<!-- 编译配置项 -->
		<OutputType>Library</OutputType>
		<TargetFramework>net48</TargetFramework>
		<Platforms>AnyCPU;x64</Platforms>
		<PlatformTarget>x64</PlatformTarget>
		<AssemblyName>RimAI.Communication.Memory</AssemblyName>

		<!-- 编译项优化 -->
		<UseSharedCompilation>false</UseSharedCompilation>
		<UseHostCompilerIfAvailable>false</UseHostCompilerIfAvailable>
		<Deterministic>true</Deterministic>
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>

		<!-- 输出文件夹 -->
		<OutputPath>$(BaseOutputPath)$(Configuration)\</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

		<!-- 杂项配置，VS开发的时候没用到过，应该是用于VScode的 -->
		<ProvideCommandLineArgs>false</ProvideCommandLineArgs>
		<LongPathsEnabled>true</LongPathsEnabled>
		<DisableImplicitFrameworkReferences>false</DisableImplicitFrameworkReferences>
	</PropertyGroup>

	<ItemGroup>
		<!-- NuGet包引用 -->
		<PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4633" PrivateAssets="All" />
		<PackageReference Include="Lib.Harmony.Ref" Version="2.*" PrivateAssets="All" />
		<!-- The installed SDK compiler supports the language features used here; avoid a .NET 9-only build tool dependency. -->
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />

		<!-- 程序集引用 -->
		<Reference Include="System.Net.Http">
			<Private>False</Private>
		</Reference>
		<ProjectReference Include="..\RimAI.Communication\RimAI.Communication.csproj">
			<Private>False</Private>
		</ProjectReference>
		<ProjectReference Include="..\RimAI.Core\src\RimAI.Core\RimAI.Core.csproj">
			<Private>False</Private>
		</ProjectReference>

		<!-- 排除文件 -->
		<Compile Remove="..\RimTalk\**" />
		<Compile Remove="backup\**" />
		<Compile Remove="Backups\**" />
		<Compile Remove="**\*.backup.cs" />
	</ItemGroup>

	<!-- 编译后自动部署 -->
	<Target Name="DeployToModsFolder" AfterTargets="Build" Condition=" '$(BuildingWithScript)' != 'true' AND '$(RimWorldDir)' != '' ">
		<CallTarget Targets="WinDeploy" Condition=" '$(OS)' == 'Windows_NT' " />
		<CallTarget Targets="MacDeploy" Condition=" '$(OS)' != 'Windows_NT' " />
	</Target>

	<!--
	  Stage assemblies into the versioned mod layout before content sync.
	  /*/Assemblies is gitignored and BaseOutputPath lives under LOCALAPPDATA, so a plain
	  robocopy/rsync of $(GameVersion) would publish Defs without the built DLL — which is
	  exactly how MainTabWindow_Memory became an unresolved XML type at runtime.
	-->
	<Target Name="StageModAssemblies">
		<MakeDir Directories="$(ProjectDir)$(GameVersion)\Assemblies" />
		<ItemGroup>
			<_StagedAssemblies Include="$(TargetPath)" />
			<_StagedAssemblies Include="$(OutputPath)Newtonsoft.Json.dll" Condition="Exists('$(OutputPath)Newtonsoft.Json.dll')" />
		</ItemGroup>
		<Copy SourceFiles="@(_StagedAssemblies)" DestinationFolder="$(ProjectDir)$(GameVersion)\Assemblies\" SkipUnchangedFiles="true" />
	</Target>

	<!-- Deploy to RimWorld client (Windows) -->
	<Target Name="WinDeploy" DependsOnTargets="StageModAssemblies">
		<PropertyGroup>
			<WinModPath>$(RimWorldDir)\Mods\$(ModFolderName)\</WinModPath>
		</PropertyGroup>
		<Message Text="Copying to $(WinModPath)" Importance="high" />
		<MakeDir Directories="$(WinModPath)" />
		<Exec Command="robocopy &quot;$(ProjectDir)About&quot; &quot;$(WinModPath)About&quot; /MIR" IgnoreExitCode="true" />
		<Exec Command="robocopy &quot;$(ProjectDir)Languages&quot; &quot;$(WinModPath)Languages&quot; /MIR" IgnoreExitCode="true" />
		<Exec Command="robocopy &quot;$(ProjectDir)Textures&quot; &quot;$(WinModPath)Textures&quot; /MIR" IgnoreExitCode="true" />
		<Exec Command="robocopy &quot;$(ProjectDir)$(GameVersion)&quot; &quot;$(WinModPath)$(GameVersion)&quot; /MIR" IgnoreExitCode="true" />
		<Message Text="--- Windows deployment finished successfully ---" Importance="high" />
	</Target>

	<!-- Deploy to RimWorld client (macOS) -->
	<Target Name="MacDeploy" DependsOnTargets="StageModAssemblies">
		<PropertyGroup>
			<DeployPath>$(RimWorldDir)/RimWorldMac.app/Mods/$(ModFolderName)/</DeployPath>
		</PropertyGroup>
		<MakeDir Directories="$(DeployPath)" />
		<Exec Command="rsync -a --delete --checksum &quot;$(ProjectDir)About/&quot; &quot;$(DeployPath)About/&quot;" />
		<Exec Command="rsync -a --delete --checksum &quot;$(ProjectDir)Languages/&quot; &quot;$(DeployPath)Languages/&quot;" />
		<Exec Command="rsync -a --delete --checksum &quot;$(ProjectDir)Textures/&quot; &quot;$(DeployPath)Textures/&quot;" />
		<Exec Command="rsync -a --delete --checksum &quot;$(ProjectDir)$(GameVersion)/&quot; &quot;$(DeployPath)$(GameVersion)/&quot;" />
		<Message Text="--- macOS deployment finished successfully ---" Importance="high" />
	</Target>

</Project>
